# Application: keep development authentication bound to localhost.
FV_ENVIRONMENT=development
FV_PUBLIC_URL=http://localhost:8000

# Redis cache: choose LOCAL Redis or UPSTASH by setting this ONE variable.
# Local Redis started by `just serve-local` (default):
FV_REDIS_URL=redis://localhost:6379/0

# UPSTASH: replace the active FV_REDIS_URL above with your Redis/TCP TLS URL.
# Upstash Console -> your Redis database -> connection details / redis-cli.
# Use its endpoint, port, and DATABASE password; keep the rediss:// TLS scheme.
# Example only (replace placeholders, and keep only one active FV_REDIS_URL):
# FV_REDIS_URL=rediss://default:YOUR_DATABASE_PASSWORD@YOUR_ENDPOINT:YOUR_PORT/0
# Prefer copying the Redis connection URL; if assembling it manually, URL-encode
# reserved characters in the password. Treat the entire URL as a secret.
# Do NOT use the https:// REST URL, UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN, or an Upstash account-management API key here.
# No separate Upstash key variables are consumed by this application.
# See README.md -> "Use Upstash instead of local Redis" for startup instructions.

# Finviz data source (separate from Upstash credentials).
# Account ID is your stable cache/quota namespace, not an Upstash ID or secret.
FV_PROVIDER_ACCOUNT_ID=owner
FV_FINVIZ_API_KEY=

# Auth0: used when development authentication is disabled.
FV_AUTH0_ISSUER=https://YOUR-TENANT.eu.auth0.com/
FV_AUTH0_AUDIENCE=http://localhost:8000/mcp

# App signing secret: generate with `openssl rand -hex 32` (not an Upstash token).
FV_CURSOR_SECRET=replace-with-at-least-32-random-characters

# Local-only access: set DEV_AUTH_ENABLED=true and replace DEV_TOKEN for local use.
# Never enable development authentication on a publicly reachable server.
FV_ACCESS_BACKEND=memory
FV_DEV_AUTH_ENABLED=false
FV_DEV_TOKEN=replace-with-a-local-only-token

# Azure membership storage: needed for Azure-backed access, not local memory mode.
FV_TABLE_ENDPOINT=
FV_BLOB_ENDPOINT=

# Optional publisher allowlist and telemetry.
FV_ARTICLE_ALLOWED_DOMAINS=[]
FV_APPLICATIONINSIGHTS_CONNECTION_STRING=
