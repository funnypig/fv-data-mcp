# Copy this file to .env once, then edit .env; never commit real credentials.
# Examples below are placeholders. Replace existing values; do not add duplicate keys.
# Keep values Bash-compatible for `just secrets-push`: quote values containing
# spaces or shell metacharacters with single quotes; never paste shell commands here.
# This template needs configuration before use; it is not a ready-to-run credential set.
#
# Choose your setup:
# - Local testing: memory backend + DEV_AUTH_ENABLED=true + a fresh DEV_TOKEN.
#   Set your Finviz key and cursor secret below; leave Azure endpoints empty.
# - Real Auth0 users / CLI grant: azure backend + your Table endpoint and Auth0 issuer.
#   See docs/operations.md for a complete CLI-only operator configuration.
# - Deployed server: production + azure + DEV_AUTH_ENABLED=false + HTTPS public URL,
#   matching Auth0 audience, real Finviz key, random cursor secret and TLS Redis.
# infra/app.bicep configures the deployed server; it does NOT upload this .env file.
# `just secrets-push` uploads only the Finviz key, Redis URL and cursor secret.

# Application environment: development | test | production (case-sensitive).
# Public URL is the server origin, WITHOUT /mcp. Keep local auth on localhost.
# Azure: Container App -> Overview -> Application URL (include https://).
# Example: FV_PUBLIC_URL=https://fvdata-mcp.YOUR_ENVIRONMENT.northeurope.azurecontainerapps.io
FV_ENVIRONMENT=development
FV_PUBLIC_URL=http://localhost:8000

# Redis cache: choose LOCAL Redis or UPSTASH by setting this ONE variable.
# Local Redis started by `just serve-local` (default):
FV_REDIS_URL=redis://localhost:6379/0

# UPSTASH: replace the active FV_REDIS_URL above with your Redis/TCP TLS URL.
# Upstash Console -> your Redis database -> connection details / redis-cli.
# Use its endpoint, port, and DATABASE password; keep the rediss:// TLS scheme.
# Example only (replace placeholders, and keep only one active FV_REDIS_URL):
# FV_REDIS_URL=rediss://default:YOUR_DATABASE_PASSWORD@YOUR_ENDPOINT:YOUR_PORT/0
# Prefer copying the Redis connection URL; if assembling it manually, URL-encode
# reserved characters in the password. Treat the entire URL as a secret.
# Do NOT use the https:// REST URL, UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN, or an Upstash account-management API key here.
# No separate Upstash key variables are consumed by this application.
# See README.md -> "Use Upstash instead of local Redis" for startup instructions.

# Finviz data source (separate from Upstash credentials).
# Account ID is your stable cache/quota namespace, not an Upstash ID or secret.
FV_PROVIDER_ACCOUNT_ID=owner
FV_FINVIZ_API_KEY=

# Auth0: used when development authentication is disabled.
# Auth0 Dashboard -> Applications -> your application -> Settings -> Domain.
# Add https:// to that domain. A missing trailing / is added automatically.
# Audience MUST equal FV_PUBLIC_URL + /mcp; use this as your Auth0 API Identifier.
# Auth0 authenticates users; Azure Table Storage separately controls who is allowed.
FV_AUTH0_ISSUER=https://YOUR-TENANT.eu.auth0.com/
FV_AUTH0_AUDIENCE=http://localhost:8000/mcp

# App signing secret: generate with `openssl rand -hex 32` (not an Upstash token).
FV_CURSOR_SECRET=replace-with-at-least-32-random-characters

# Membership backend: ONLY memory | azure are supported (case-sensitive).
# memory: temporary allowlist in this process; lost on restart, not shared between
# replicas. Intended for local tests with development authentication enabled.
# It pre-authorizes only the local developer in that mode, not real Auth0 users.
# The grant/suspend/backup/restore CLI commands do not support memory mode.
# azure: persistent allowlist in Azure Table Storage; required in production and
# for CLI membership administration. Set FV_TABLE_ENDPOINT below.
# This setting does NOT select the market-data cache: both modes still use Redis.
FV_ACCESS_BACKEND=memory

# Local-only authentication: true | false. For local testing set true and generate
# FV_DEV_TOKEN with `openssl rand -hex 32` (minimum 24 characters).
# Never enable this on a publicly reachable server. With false, use real Auth0
# credentials and azure membership storage, not the empty memory allowlist.
FV_DEV_AUTH_ENABLED=false
FV_DEV_TOKEN=replace-with-a-local-only-token

# Azure endpoints: BOTH belong to an Azure STORAGE ACCOUNT, not Key Vault,
# Container Registry, Container Apps, Cosmos DB or Upstash.
# infra/foundation.bicep creates one StorageV2 account with:
# - Table Storage: table "members" stores enabled/disabled user memberships.
# - Blob Storage: container "access-backups" stores membership backup files.
# These services do not store the option-data cache; that remains in Redis.
#
# Find your real endpoints:
# 1. Azure Portal -> Resource groups -> fv-data-mcp-prod (or your group).
# 2. Open the resource whose TYPE is "Storage account". The registry may have
#    the same name; make sure you are NOT opening "Container registry".
# 3. Storage account -> Settings -> Endpoints -> copy the PRIMARY Table and Blob URLs.
# Or run this in your terminal (replace YOUR_STORAGE_ACCOUNT and the group):
# az storage account show -g fv-data-mcp-prod -n YOUR_STORAGE_ACCOUNT --query primaryEndpoints -o json
# Copy the "table" and "blob" values from that output, not the entire JSON object.
# Foundation deployment outputs also expose tableEndpoint, blobEndpoint and storageName.
# Reference: https://learn.microsoft.com/en-us/azure/storage/common/storage-account-get-info
#
# Required when FV_ACCESS_BACKEND=azure; leave blank for memory.
# Example for a FICTIONAL account named fvdataexample123:
# FV_TABLE_ENDPOINT=https://fvdataexample123.table.core.windows.net/
FV_TABLE_ENDPOINT=

# Required only for backup-members / restore-members; optional for serve/grant/suspend.
# FV_BLOB_ENDPOINT=https://fvdataexample123.blob.core.windows.net/
FV_BLOB_ENDPOINT=

# Table name, NOT an endpoint. Keep "members" for the supplied infrastructure.
# Change only if you provision another table and point both server and CLI at it.
FV_ACCESS_TABLE=members

# Endpoint values are base HTTPS URLs, NOT secrets or connection strings.
# Do NOT append /members, /access-backups, access keys or SAS query parameters.
# Authentication uses Azure identity (DefaultAzureCredential), not a storage key.
# Locally, run `az login` with your operator account; in Azure, the supplied
# infrastructure gives the server's managed identity read access to memberships.
# For local grant/suspend/restore: Storage account -> Access control (IAM) ->
# Add role assignment -> "Storage Table Data Contributor" -> your operator user.
# For backups/restores also grant "Storage Blob Data Contributor" on that account.
# Subscription Owner alone does not grant storage data access. Allow role propagation.
# Your Azure operator identity is NOT the Auth0 user ID passed to `grant --subject`.
# Reference: https://learn.microsoft.com/en-us/azure/storage/tables/assign-azure-role-data-access

# Optional article-domain allowlist, a JSON array. [] means no publisher restriction;
# URL/network safety checks still apply. Listed domains also allow their subdomains.
# Example: FV_ARTICLE_ALLOWED_DOMAINS='["reuters.com","www.reuters.com"]'
FV_ARTICLE_ALLOWED_DOMAINS=[]

# Optional telemetry: blank disables Application Insights export.
# Azure Portal -> Application Insights -> fvdata-insights -> Overview -> Connection String.
# Copy the WHOLE connection string, not just the Instrumentation Key or workspace ID.
# Single-quote it because it contains semicolons, e.g.:
# FV_APPLICATIONINSIGHTS_CONNECTION_STRING='InstrumentationKey=YOUR_KEY;IngestionEndpoint=https://YOUR_INGESTION_HOST/'
# infra/app.bicep supplies this automatically for the deployed server.
FV_APPLICATIONINSIGHTS_CONNECTION_STRING=
